# Reference only: the API does not automatically load .env files.
# Set these variables in the shell running the documented Python entry point.
TRADING_API_ENVIRONMENT=development
TRADING_API_PORT=8000
TRADING_API_AUTH_ENABLED=false
TRADING_API_FRONTEND_ENABLED=false
TRADING_API_HTTPS_ENABLED=false
TRADING_API_INDMONEY_ENABLED=false
# Local INDmoney setup additionally requires port 8443, authentication, a trusted
# certificate and encrypted registration/keys; see docs/indmoney-authorization.md.
# Optional browser authentication: configure the provider and private session key
# using docs/browser-sessions.md. Never place actual credentials in this example.
